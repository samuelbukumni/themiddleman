# ─────────────────────────────────────────────
# The Middleman — Environment Variables Template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file with real secrets.
# ─────────────────────────────────────────────

# ── Supabase ──
# Project ref: uwigyojtiudefnwjezhm (West US region)
NEXT_PUBLIC_SUPABASE_URL=https://uwigyojtiudefnwjezhm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service role key — server-side only, NEVER expose to the client/browser.
# Used in Edge Functions / server routes that need to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── AI — Smart Listing Assistant ──
GEMINI_API_KEY=your_gemini_api_key_here

# ── Maps (billing risk — monitor usage) ──
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ── Payments (Phase 4+) ──
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here

# ── App Config ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="The Middleman"

# ── WhatsApp fallback contact ──
NEXT_PUBLIC_WHATSAPP_NUMBER=+2347066316607
